# ── Telegram ─────────────────────────────────────────────────────────────────
# Create a bot with @BotFather, then get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Solana (free at helius.dev) ───────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key

# ── Ethereum (free at etherscan.io/apis) ─────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key

# ── Thresholds (optional — these are the defaults) ───────────────────────────
# Alert only if top single holder owns less than this % of total supply
MAX_TOP_HOLDER_PCT=20.0

# Skip pools with less than this USD liquidity (filters dust/honeypot pools)
MIN_LIQUIDITY_USD=500.0

# How often to poll GeckoTerminal for new pools (seconds)
SOLANA_POLL_INTERVAL=30
ETH_POLL_INTERVAL=15
